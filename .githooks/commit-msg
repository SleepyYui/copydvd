#!/bin/bash

# Commit-msg hook for commit message validation
# This script validates commit messages but does not perform version bumping
# (Version bumping is now handled by the pre-commit hook)

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get the commit message from the file passed as argument
if [ -n "$1" ] && [ -f "$1" ]; then
    COMMIT_MSG=$(head -1 "$1" 2>/dev/null)
else
    echo -e "${RED}❌ Error: No commit message file provided${NC}"
    exit 1
fi

# If we don't have a commit message, exit with error
if [ -z "$COMMIT_MSG" ]; then
    echo -e "${RED}❌ Empty commit message not allowed${NC}"
    exit 1
fi

echo -e "${BLUE}🔍 Validating commit message: ${NC}\"$COMMIT_MSG\""

# Basic validation - ensure message is not just whitespace
if [[ "$COMMIT_MSG" =~ ^[[:space:]]*$ ]]; then
    echo -e "${RED}❌ Commit message cannot be empty or only whitespace${NC}"
    exit 1
fi

# Check message length (optional - warn if too short)
if [ ${#COMMIT_MSG} -lt 10 ]; then
    echo -e "${YELLOW}⚠️  Commit message is quite short (${#COMMIT_MSG} characters)${NC}"
    echo -e "${YELLOW}   Consider adding more descriptive information${NC}"
fi

# Show conventional commit type if detected
if echo "$COMMIT_MSG" | grep -qE "^(feat|fix|docs|style|refactor|perf|test|chore)(\(.+\))?:"; then
    COMMIT_TYPE=$(echo "$COMMIT_MSG" | sed -E 's/^([a-z]+)(\(.+\))?:.*/\1/')
    echo -e "${GREEN}✅ Conventional commit detected: ${NC}$COMMIT_TYPE"
elif echo "$COMMIT_MSG" | grep -qE "(BREAKING CHANGE|!:|feat!|fix!|perf!)"; then
    echo -e "${RED}🔥 Breaking change detected${NC}"
elif echo "$COMMIT_MSG" | grep -qE "\[skip version\]|\[version skip\]"; then
    echo -e "${YELLOW}⚠️  Version bump will be skipped${NC}"
fi

echo -e "${GREEN}✅ Commit message validation passed${NC}"
exit 0