#!/bin/bash

# Pre-commit hook for automatic version bumping
# This script automatically increments the version in Cargo.toml based on conventional commit messages

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get the commit message from the standard input or environment
# In pre-commit hooks, the commit message is passed via stdin
if [ -t 0 ]; then
    # If stdin is not available, try to read from git
    COMMIT_MSG_FILE=".git/COMMIT_EDITMSG"
    if [ -f "$COMMIT_MSG_FILE" ]; then
        COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")
    else
        echo -e "${YELLOW}⚠️  No commit message found, skipping version bump${NC}"
        exit 0
    fi
else
    # Read commit message from stdin
    COMMIT_MSG=$(cat)
fi

# If we still don't have a commit message, skip version bumping
if [ -z "$COMMIT_MSG" ]; then
    echo -e "${YELLOW}⚠️  No commit message found, skipping version bump${NC}"
    exit 0
fi

# Check for skip version flags first
if echo "$COMMIT_MSG" | grep -qE "\[skip version\]|\[version skip\]"; then
    echo -e "${YELLOW}⚠️  Version bump explicitly skipped via [skip version] flag${NC}"
    exit 0
fi

echo -e "${BLUE}🔍 Analyzing commit message: ${NC}\"$COMMIT_MSG\""

# Check for skip version flags first (highest priority)
if echo "$COMMIT_MSG" | grep -qE "\[skip version\]|\[version skip\]"; then
    echo -e "${YELLOW}⚠️  Version bump explicitly skipped via [skip version] flag${NC}"
    exit 0
fi

echo -e "${GREEN}🔧 Automatic version bump enabled${NC}"

# Function to get current version from Cargo.toml
get_current_version() {
    grep '^version = ' Cargo.toml | sed 's/version = "\(.*\)"/\1/'
}

# Function to increment version
increment_version() {
    local version=$1
    local bump_type=$2
    
    # Split version into parts
    IFS='.' read -ra VERSION_PARTS <<< "$version"
    local major=${VERSION_PARTS[0]}
    local minor=${VERSION_PARTS[1]}
    local patch=${VERSION_PARTS[2]}
    
    case $bump_type in
        "major")
            major=$((major + 1))
            minor=0
            patch=0
            ;;
        "minor")
            minor=$((minor + 1))
            patch=0
            ;;
        "patch")
            patch=$((patch + 1))
            ;;
        *)
            echo -e "${RED}❌ Invalid bump type: $bump_type${NC}"
            exit 1
            ;;
    esac
    
    echo "$major.$minor.$patch"
}

# Function to update version in Cargo.toml
update_cargo_version() {
    local new_version=$1
    sed -i.bak "s/^version = \".*\"/version = \"$new_version\"/" Cargo.toml
    rm -f Cargo.toml.bak
}

# Determine version bump type based on conventional commit format
determine_bump_type() {
    local msg="$1"
    
    # Check for breaking changes (major bump)
    if echo "$msg" | grep -qE "(BREAKING CHANGE|!:|feat!|fix!|perf!)"; then
        echo "major"
        return
    fi
    
    # Check for features (minor bump)
    if echo "$msg" | grep -qE "^feat(\(.+\))?:"; then
        echo "minor"
        return
    fi
    
    # Check for fixes, docs, style, refactor, test, chore (patch bump)
    if echo "$msg" | grep -qE "^(fix|docs|style|refactor|perf|test|chore)(\(.+\))?:"; then
        echo "patch"
        return
    fi
    
    # Check for other common patterns that should trigger patch bump
    if echo "$msg" | grep -qiE "(bug|hotfix|patch|update|improve|enhance|optimize)"; then
        echo "patch"
        return
    fi
    
    # Default to patch for any other changes
    echo "patch"
}

# Main logic
CURRENT_VERSION=$(get_current_version)
BUMP_TYPE=$(determine_bump_type "$COMMIT_MSG")
NEW_VERSION=$(increment_version "$CURRENT_VERSION" "$BUMP_TYPE")

echo -e "${BLUE}📦 Current version: ${NC}$CURRENT_VERSION"
echo -e "${BLUE}🎯 Bump type: ${NC}$BUMP_TYPE"
echo -e "${BLUE}🆕 New version: ${NC}$NEW_VERSION"

# Check if version actually changed
if [ "$CURRENT_VERSION" = "$NEW_VERSION" ]; then
    echo -e "${YELLOW}⚠️  Version unchanged, skipping update${NC}"
    exit 0
fi

# Update Cargo.toml
echo -e "${BLUE}📝 Updating Cargo.toml...${NC}"
update_cargo_version "$NEW_VERSION"

# Verify the update worked
UPDATED_VERSION=$(get_current_version)
if [ "$UPDATED_VERSION" != "$NEW_VERSION" ]; then
    echo -e "${RED}❌ Failed to update version in Cargo.toml${NC}"
    exit 1
fi

# Stage the updated Cargo.toml
git add Cargo.toml

echo -e "${GREEN}✅ Version bumped from $CURRENT_VERSION to $NEW_VERSION${NC}"
echo -e "${GREEN}📁 Cargo.toml updated and staged${NC}"

# Update Cargo.lock if it exists
if [ -f "Cargo.lock" ]; then
    echo -e "${BLUE}🔄 Updating Cargo.lock...${NC}"
    cargo check --quiet 2>/dev/null || true
    if [ -f "Cargo.lock" ] && git diff --quiet Cargo.lock; then
        echo -e "${YELLOW}⚠️  Cargo.lock unchanged${NC}"
    else
        git add Cargo.lock
        echo -e "${GREEN}📁 Cargo.lock updated and staged${NC}"
    fi
fi

# Create git tag for the new version
echo -e "${BLUE}🏷️  Creating git tag v$NEW_VERSION...${NC}"
if git tag "v$NEW_VERSION" 2>/dev/null; then
    echo -e "${GREEN}📌 Git tag v$NEW_VERSION created${NC}"
else
    echo -e "${YELLOW}⚠️  Tag v$NEW_VERSION already exists or failed to create${NC}"
fi

echo -e "${GREEN}🎉 Automatic version bump complete!${NC}"

# Show commit message classification
case $BUMP_TYPE in
    "major")
        echo -e "${RED}🔥 MAJOR version bump - Breaking changes detected${NC}"
        ;;
    "minor")
        echo -e "${YELLOW}✨ MINOR version bump - New features detected${NC}"
        ;;
    "patch")
        echo -e "${GREEN}🐛 PATCH version bump - Bug fixes/improvements detected${NC}"
        ;;
esac

exit 0