name: CI/CD Pipeline

on:
  push:
    branches: [v2, main]
    tags: ['v*']
  pull_request:
    branches: [v2, main]
  workflow_dispatch:
    inputs:
      force_release:
        description: 'Force create release'
        required: false
        default: false
        type: boolean

env:
  CARGO_TERM_COLOR: always
  RUST_BACKTRACE: 1
  RUSTFLAGS: "-D warnings"

jobs:
  # Job 1: Generate version and update Cargo.toml
  version:
    name: Generate Version
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/v2' || startsWith(github.ref, 'refs/tags/v') || (github.event_name == 'workflow_dispatch' && github.event.inputs.force_release == 'true')
    outputs:
      version: ${{ steps.version.outputs.version }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          token: ${{ secrets.GITHUB_TOKEN }}
          persist-credentials: true

      - name: Install Rust
        uses: dtolnay/rust-toolchain@stable

      - name: Generate version and update Cargo.toml
        id: version
        run: |
          # Determine version
          if [[ "${{ github.ref }}" == refs/tags/* ]]; then
            # Use tag version
            VERSION=${GITHUB_REF#refs/tags/v}
            echo "Using tag version: $VERSION"
          else
            # Auto-generate semver-compliant version from date and commit
            YEAR=$(date +'%Y')
            MONTH=$(date +'%-m')  # Remove leading zero
            DAY=$(date +'%-d')    # Remove leading zero
            SHORT_SHA=$(git rev-parse --short HEAD)
            # Convert hex SHA to decimal for patch version
            PATCH_NUM=$((0x${SHORT_SHA}))
            # Ensure patch number is reasonable (max 6 digits)
            PATCH_NUM=$((PATCH_NUM % 999999))
            VERSION="${YEAR}.${MONTH}.${DAY}-${PATCH_NUM}"
            echo "Generated version: $VERSION"
          fi
          
          # Update Cargo.toml with new version
          echo "Updating Cargo.toml version to: $VERSION"
          sed -i.bak "s/^version = \".*\"/version = \"$VERSION\"/" Cargo.toml
          rm -f Cargo.toml.bak
          
          # Note: Skipping cargo check since we already validated everything in quality job
          
          # Configure git for automated commits
          git config --global user.name 'github-actions[bot]'
          git config --global user.email 'github-actions[bot]@users.noreply.github.com'
          
          # Check if we need to commit version changes
          if ! git diff --quiet Cargo.toml; then
            echo "Committing version update..."
            git add Cargo.toml
            git commit -m "chore: bump version to $VERSION [skip ci]"
            
            # Create and push tag for the new version (only if not already a tag build)
            if [[ "${{ github.ref }}" != refs/tags/* ]]; then
              TAG_NAME="v$VERSION"
              if ! git tag --list | grep -q "^$TAG_NAME$"; then
                git tag "$TAG_NAME"
                echo "Created new tag: $TAG_NAME"
                
                # Push changes and tag
                git push origin HEAD:${{ github.ref_name }} || echo "Failed to push commit"
                git push origin "$TAG_NAME" || echo "Failed to push tag"
              else
                echo "Tag $TAG_NAME already exists"
              fi
            fi
          else
            echo "No version changes needed"
          fi
          
          echo "version=$VERSION" >> $GITHUB_OUTPUT
          echo "Final version: $VERSION"

  # Job 2: Code Quality and Testing
  quality:
    name: Code Quality
    runs-on: ubuntu-latest
    needs: version
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          ref: ${{ github.ref }}
          fetch-depth: 0

      - name: Install Rust
        uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt, clippy

      - name: Rust Cache
        uses: Swatinem/rust-cache@v2
        with:
          cache-on-failure: true

      - name: Install Linux dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y build-essential pkg-config libx11-dev libxrandr-dev libxi-dev libgl1-mesa-dev libglib2.0-dev libglib2.0-dev-bin libgtk-3-dev libcairo2-dev libpango1.0-dev libgdk-pixbuf2.0-dev libatk1.0-dev

      - name: Check formatting
        run: cargo fmt --all -- --check

      - name: Run clippy
        run: cargo clippy --all-targets --all-features -- -D warnings

      - name: Run tests
        run: cargo test --release --verbose --all-features

  # Job 3: Cross-platform builds
  build:
    name: Build ${{ matrix.target }}
    runs-on: ${{ matrix.os }}
    needs: [version, quality]
    strategy:
      fail-fast: false
      matrix:
        include:
          # Linux x86_64
          - os: ubuntu-latest
            target: x86_64-unknown-linux-gnu
            binary: copydvd
            use_cross: false
            features: "--all-features"
          
          
          # macOS Intel
          - os: macos-latest
            target: x86_64-apple-darwin
            binary: copydvd
            use_cross: false
            features: "--all-features"
          
          # macOS Apple Silicon
          - os: macos-latest
            target: aarch64-apple-darwin
            binary: copydvd
            use_cross: false
            features: "--all-features"
          
          # Windows x86_64
          - os: windows-latest
            target: x86_64-pc-windows-msvc
            binary: copydvd.exe
            use_cross: false
            features: "--all-features"

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          ref: ${{ github.ref }}
          fetch-depth: 0

      - name: Install Rust
        uses: dtolnay/rust-toolchain@stable
        with:
          targets: ${{ matrix.target }}

      - name: Rust Cache
        uses: Swatinem/rust-cache@v2
        with:
          key: ${{ matrix.target }}
          cache-on-failure: true

      - name: Install Linux dependencies
        if: runner.os == 'Linux' && !matrix.use_cross
        run: |
          sudo apt-get update
          sudo apt-get install -y build-essential pkg-config libx11-dev libxrandr-dev libxi-dev libgl1-mesa-dev libglib2.0-dev libglib2.0-dev-bin libgtk-3-dev libcairo2-dev libpango1.0-dev libgdk-pixbuf2.0-dev libatk1.0-dev

      - name: Install cross
        if: matrix.use_cross
        run: |
          # Install cross with warnings allowed for static references
          RUSTFLAGS="" cargo install cross --git https://github.com/cross-rs/cross --force
          
      - name: Build binary
        shell: bash
        run: |
          BUILD_CMD="cargo"
          if [[ "${{ matrix.use_cross }}" == "true" ]]; then
            BUILD_CMD="cross"
          fi
          
          echo "Building with: $BUILD_CMD build --release --target ${{ matrix.target }} ${{ matrix.features }}"
          $BUILD_CMD build --release --target ${{ matrix.target }} ${{ matrix.features }}
          
          # Verify binary exists
          BINARY_PATH="target/${{ matrix.target }}/release/${{ matrix.binary }}"
          if [[ ! -f "$BINARY_PATH" ]]; then
            echo "❌ Binary not found at $BINARY_PATH"
            exit 1
          fi
          
          echo "✅ Binary built successfully: $BINARY_PATH"
          ls -la "$BINARY_PATH"

      - name: Strip binary (Unix)
        if: runner.os != 'Windows'
        run: strip target/${{ matrix.target }}/release/${{ matrix.binary }}

      - name: Create App Bundle (macOS)
        if: runner.os == 'macOS'
        run: |
          if [[ -f "create_app_bundle.sh" ]]; then
            chmod +x create_app_bundle.sh
            # Pass the version from the version job to the script
            VERSION="${{ needs.version.outputs.version }}" ./create_app_bundle.sh ${{ matrix.target }}
            
            # The create_app_bundle.sh script now creates .pkg installer
            # Check if PKG installer was created
            if ls CopyDVD-*.pkg 1> /dev/null 2>&1; then
              echo "✅ PKG installer created successfully"
              ls -la CopyDVD-*.pkg
            else
              echo "⚠️ No PKG installer found, checking for app bundle..."
              if [[ -d "CopyDVD.app" ]]; then
                echo "✅ App bundle exists but no PKG installer created"
                ls -la CopyDVD.app
              fi
            fi
          else
            echo "create_app_bundle.sh not found, skipping app bundle creation"
          fi

      - name: Create Windows MSI Installer
        if: runner.os == 'Windows'
        shell: pwsh
        run: |
          # Install WiX Toolset via chocolatey
          Write-Host "Installing WiX Toolset..."
          choco install wixtoolset -y
          
          # Refresh PATH to include WiX tools
          $env:PATH = [Environment]::GetEnvironmentVariable("PATH", "Machine") + ";" + [Environment]::GetEnvironmentVariable("PATH", "User")
          
          # Use version from the version job
          $CargoVersion = "${{ needs.version.outputs.version }}"
          
          # Convert version to WiX-compatible format (x.x.x.x)
          # WiX requires: major < 256, minor < 256, patch < 65536, build < 65536
          if ($CargoVersion -match '^(\d+)\.(\d+)\.(\d+)-(\d+)$') {
              # Convert year-based version to smaller numbers
              $yearPart = [int]$matches[1]
              $major = $yearPart % 100  # Last two digits of year (2025 -> 25)
              $minor = [Math]::Min([int]$matches[2], 255)  # Month (1-12, fits easily)
              $patch = [Math]::Min([int]$matches[3], 65535)  # Day (1-31, fits easily)
              $buildNum = [int]$matches[4]
              $build = $buildNum % 65535  # Build number wrapped
              $Version = "$major.$minor.$patch.$build"
          } elseif ($CargoVersion -match '^(\d+)\.(\d+)\.(\d+)$') {
              # Handle standard semver format
              $major = [Math]::Min([int]$matches[1], 255)
              $minor = [Math]::Min([int]$matches[2], 255)
              $patch = [Math]::Min([int]$matches[3], 65535)
              $Version = "$major.$minor.$patch.0"
          } else {
              # Fallback version
              $Version = "1.0.0.0"
          }
          
          Write-Host "Cargo version: $CargoVersion"
          Write-Host "WiX version: $Version"
          
          $BinaryPath = "target\${{ matrix.target }}\release\copydvd.exe"
          
          # Create a proper ICO file for WiX installer
          Write-Host "Creating ICO file for installer..."
          
          # Try to create a proper ICO file using PowerShell
          $IconCreated = $false
          $IconSources = @(
            "resources\icons\icon-32.png",
            "resources\icons\icon-16.png", 
            "resources\icons\icon-64.png",
            "resources\icons\icon-128.png"
          )
          
          foreach ($IconSource in $IconSources) {
            if (Test-Path $IconSource) {
              try {
                # Load System.Drawing to work with images
                Add-Type -AssemblyName System.Drawing
                
                # Load the PNG image
                $img = [System.Drawing.Image]::FromFile((Resolve-Path $IconSource))
                
                # Create a bitmap from the image
                $bitmap = New-Object System.Drawing.Bitmap($img)
                
                # Create an icon from the bitmap
                $iconHandle = $bitmap.GetHicon()
                $icon = [System.Drawing.Icon]::FromHandle($iconHandle)
                
                # Save as ICO file
                $iconStream = [System.IO.File]::Create("copydvd-icon.ico")
                $icon.Save($iconStream)
                $iconStream.Close()
                
                # Clean up
                $icon.Dispose()
                $bitmap.Dispose()
                $img.Dispose()
                
                Write-Host "✅ ICO file created from $IconSource"
                $IconCreated = $true
                break
              } catch {
                Write-Host "⚠️ Failed to convert $IconSource to ICO: $_"
              }
            }
          }
          
          # Fallback: Create a simple ICO by copying PNG (WiX might accept it)
          if (-not $IconCreated) {
            foreach ($IconSource in $IconSources) {
              if (Test-Path $IconSource) {
                Copy-Item $IconSource "copydvd-icon.ico"
                Write-Host "✅ Fallback: PNG copied as ICO from $IconSource"
                $IconCreated = $true
                break
              }
            }
          }
          
          if (-not $IconCreated) {
            Write-Host "❌ Warning: No icon files found"
            # Don't create empty file - let WiX fail gracefully without icon
          }
          
          # Create WiX source file with conditional icon support
          $IconDeclaration = if ($IconCreated) { "              <Icon Id=`"CopyDVDIcon`" SourceFile=`"copydvd-icon.ico`" />" } else { "" }
          $IconAttribute = if ($IconCreated) { "Icon=`"CopyDVDIcon`" " } else { "" }
          
          $WixSource = @"
          <?xml version="1.0" encoding="UTF-8"?>
          <Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
            <Product Id="*" Name="Copy DVD" Language="1033" Version="$Version" Manufacturer="Copy DVD Team" UpgradeCode="12345678-1234-1234-1234-123456789012">
              <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />
              
              <MajorUpgrade DowngradeErrorMessage="A newer version of Copy DVD is already installed." />
              <MediaTemplate EmbedCab="yes" />
              
              <Feature Id="ProductFeature" Title="Copy DVD" Level="1">
                <ComponentGroupRef Id="ProductComponents" />
                <ComponentRef Id="StartMenuComponent" />
                <ComponentRef Id="StartMenuShortcutComponent" />
                <ComponentRef Id="DesktopShortcutComponent" />
              </Feature>
              
              <Directory Id="TARGETDIR" Name="SourceDir">
                <Directory Id="ProgramFilesFolder">
                  <Directory Id="INSTALLFOLDER" Name="Copy DVD" />
                </Directory>
                <Directory Id="ProgramMenuFolder">
                  <Directory Id="ApplicationProgramsFolder" Name="Copy DVD"/>
                </Directory>
                <Directory Id="DesktopFolder" />
              </Directory>
              
          $IconDeclaration
              
              <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
                <Component Id="MainExecutable" Guid="87654321-4321-4321-4321-210987654321">
                  <File Id="CopyDVDExe" Source="$BinaryPath" KeyPath="yes" />
                </Component>
              </ComponentGroup>
              
              <Component Id="StartMenuShortcutComponent" Directory="ApplicationProgramsFolder" Guid="22222222-2222-2222-2222-222222222222">
                <Shortcut Id="ApplicationStartMenuShortcut" Target="[INSTALLFOLDER]copydvd.exe" 
                          Name="Copy DVD" WorkingDirectory="INSTALLFOLDER" 
                          ${IconAttribute}Advertise="no" />
                <RemoveFolder Id="ApplicationProgramsFolderRemove" On="uninstall" />
                <RegistryValue Root="HKCU" Key="Software\CopyDVD\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
              </Component>
              
              <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="33333333-3333-3333-3333-333333333333">
                <Shortcut Id="DesktopShortcut" Target="[INSTALLFOLDER]copydvd.exe" 
                          Name="Copy DVD" WorkingDirectory="INSTALLFOLDER" 
                          ${IconAttribute}Advertise="no" />
                <RegistryValue Root="HKCU" Key="Software\CopyDVD\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
              </Component>
              
              <Component Id="StartMenuComponent" Directory="ApplicationProgramsFolder" Guid="11111111-1111-1111-1111-111111111111">
                <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
                <RegistryValue Root="HKCU" Key="Software\CopyDVD" Name="installed" Type="integer" Value="1" KeyPath="yes" />
              </Component>
            </Product>
          </Wix>
          "@
          
          # Write WiX source to file
          $WixSource | Out-File -FilePath "CopyDVD.wxs" -Encoding UTF8
          
          # Compile the installer
          Write-Host "Compiling MSI installer..."
          & "C:\Program Files (x86)\WiX Toolset v3.14\bin\candle.exe" CopyDVD.wxs
          
          # Use consistent naming: copydvd-windows-VERSION.msi
          $MSI_NAME = "copydvd-windows-$CargoVersion.msi"
          & "C:\Program Files (x86)\WiX Toolset v3.14\bin\light.exe" -out $MSI_NAME CopyDVD.wixobj
          
          if (Test-Path $MSI_NAME) {
            Write-Host "MSI installer created successfully: $MSI_NAME"
            
            # Also create a symlink with the old name for compatibility  
            Copy-Item $MSI_NAME "CopyDVD-${{ matrix.target }}.msi"
          } else {
            Write-Error "Failed to create MSI installer"
          }

      - name: Upload binary
        uses: actions/upload-artifact@v4
        with:
          name: copydvd-${{ matrix.target }}
          path: |
            target/${{ matrix.target }}/release/${{ matrix.binary }}
            CopyDVD-*.pkg
            copydvd-*.msi
            CopyDVD-*.msi
          if-no-files-found: ignore
          retention-days: 30

  # Job 4: Create Release (automatically on v2 pushes, tags, or manual trigger)
  release:
    name: Create Release
    runs-on: ubuntu-latest
    needs: [version, quality, build]
    if: github.ref == 'refs/heads/v2' || startsWith(github.ref, 'refs/tags/v') || (github.event_name == 'workflow_dispatch' && github.event.inputs.force_release == 'true')
    permissions:
      contents: write
    
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          token: ${{ secrets.GITHUB_TOKEN }}
          persist-credentials: true

      - name: Get version from previous job
        id: version
        run: |
          echo "version=${{ needs.version.outputs.version }}" >> $GITHUB_OUTPUT
          echo "Using version from version job: ${{ needs.version.outputs.version }}"

      - name: Download all artifacts
        uses: actions/download-artifact@v4
        with:
          path: artifacts/

      - name: Prepare release assets
        run: |
          mkdir -p release/
          VERSION="${{ steps.version.outputs.version }}"
          
          # Process each artifact with consistent naming
          for artifact_dir in artifacts/copydvd-*; do
            if [[ -d "$artifact_dir" ]]; then
              target=$(basename "$artifact_dir" | sed 's/copydvd-//')
              echo "Processing $target..."
              
              # Determine OS name for consistent naming
              case "$target" in
                "x86_64-pc-windows-msvc")
                  os_name="windows"
                  binary_ext=".exe"
                  ;;
                "x86_64-apple-darwin")
                  os_name="macos-intel" 
                  binary_ext=""
                  ;;
                "aarch64-apple-darwin")
                  os_name="macos-arm"
                  binary_ext=""
                  ;;
                "x86_64-unknown-linux-gnu")
                  os_name="linux"
                  binary_ext=""
                  ;;
                *)
                  os_name="$target"
                  binary_ext=""
                  ;;
              esac
              
              # Debug: List all files in artifact directory
              echo "📁 Files in $artifact_dir:"
              find "$artifact_dir" -type f | head -10
              
              # Find and rename binary (try multiple approaches)
              binary_file=""
              
              # Try different search patterns
              if [[ "$target" == *"windows"* ]]; then
                binary_file=$(find "$artifact_dir" -name "copydvd.exe" -type f | head -1)
                [[ -z "$binary_file" ]] && binary_file=$(find "$artifact_dir" -name "copydvd*.exe" -type f | head -1)
              else
                binary_file=$(find "$artifact_dir" -name "copydvd" -type f | head -1)
                [[ -z "$binary_file" ]] && binary_file=$(find "$artifact_dir" -name "copydvd*" -type f ! -name "*.zip" ! -name "*.msi" ! -name "*.app" | head -1)
              fi
              
              if [[ -n "$binary_file" ]] && [[ -f "$binary_file" ]]; then
                new_name="copydvd-${os_name}-${VERSION}${binary_ext}"
                cp "$binary_file" "release/$new_name"
                echo "✅ Prepared binary: $new_name (from $(basename "$binary_file"))"
              else
                echo "❌ Binary not found for $target"
              fi
              
              # Handle macOS PKG installer
              pkg_file=$(find "$artifact_dir" -name "*.pkg" -type f | head -1)
              if [[ -n "$pkg_file" ]]; then
                # Rename PKG to consistent format
                new_pkg_name="copydvd-${os_name}-${VERSION}.pkg"
                cp "$pkg_file" "release/$new_pkg_name"
                echo "✅ Prepared PKG installer: $new_pkg_name (from $(basename "$pkg_file"))"
              fi
              
              # Handle Windows MSI installer with both old and new naming
              msi_file=$(find "$artifact_dir" -name "*.msi" -type f | head -1)
              if [[ -n "$msi_file" ]]; then
                # Rename to consistent format if needed
                if [[ "$(basename "$msi_file")" != "copydvd-windows-${VERSION}.msi" ]]; then
                  new_msi_name="copydvd-windows-${VERSION}.msi"
                  cp "$msi_file" "release/$new_msi_name"
                  echo "✅ Prepared MSI installer: $new_msi_name (from $(basename "$msi_file"))"
                else
                  cp "$msi_file" "release/"
                  echo "✅ Prepared MSI installer: $(basename "$msi_file")"
                fi
              fi
            fi
          done
          
          echo "Release assets prepared:"
          ls -la release/


      - name: Generate AI-powered release notes
        id: ai_release_notes
        run: |
          # Get previous tag for comparison
          PREVIOUS_TAG=""
          if git describe --tags --abbrev=0 2>/dev/null > /dev/null; then
            PREVIOUS_TAG=$(git describe --tags --abbrev=0 HEAD~1 2>/dev/null || "")
          fi
          
          # Build comparison range
          if [[ -n "$PREVIOUS_TAG" ]]; then
            COMPARE_RANGE="$PREVIOUS_TAG..HEAD"
            echo "Comparing changes from $PREVIOUS_TAG to HEAD"
          else
            COMPARE_RANGE="HEAD"
            echo "Initial release - analyzing all commits"
          fi
          
          # Create preliminary release to let GitHub AI analyze the code
          echo "Creating draft release for AI analysis..."
          
          # Build info for footer
          BUILD_TYPE="Automatic Release"
          if [[ "${{ github.ref }}" == refs/tags/* ]]; then
            BUILD_TYPE="Tagged Release"
          elif [[ "${{ github.event_name }}" == "workflow_dispatch" ]]; then
            BUILD_TYPE="Manual Release"
          fi
          
          # Generate release notes using the dedicated API endpoint - 100% reliable!
          echo "📝 Generating AI release notes using GitHub's dedicated API..."
          
          # Prepare data for release notes generation
          if [[ -n "$PREVIOUS_TAG" ]]; then
            GENERATE_NOTES_DATA=$(cat << EOF
            {
              "tag_name": "v${{ steps.version.outputs.version }}",
              "target_commitish": "${{ github.sha }}",
              "previous_tag_name": "$PREVIOUS_TAG"
            }
            EOF
            )
          else
            GENERATE_NOTES_DATA=$(cat << EOF
            {
              "tag_name": "v${{ steps.version.outputs.version }}",
              "target_commitish": "${{ github.sha }}"
            }
            EOF
            )
          fi
          
          echo "Calling GitHub's release notes generation API..."
          
          # Call the dedicated generate-notes endpoint
          NOTES_RESPONSE=$(curl -L \
            -X POST \
            -H "Accept: application/vnd.github+json" \
            -H "Authorization: Bearer ${{ secrets.GITHUB_TOKEN }}" \
            -H "X-GitHub-Api-Version: 2022-11-28" \
            https://api.github.com/repos/${{ github.repository }}/releases/generate-notes \
            -d "$GENERATE_NOTES_DATA")
          
          echo "Raw API response:"
          echo "$NOTES_RESPONSE" | jq .
          
          # Extract the generated release notes
          AI_NOTES=$(echo "$NOTES_RESPONSE" | jq -r '.body // ""')
          GENERATED_NAME=$(echo "$NOTES_RESPONSE" | jq -r '.name // ""')
          
          # Validate we got good content
          if [[ -n "$AI_NOTES" ]] && [[ ${#AI_NOTES} -gt 50 ]]; then
            echo "✅ Successfully generated ${#AI_NOTES} characters of AI release notes!"
            if [[ -n "$GENERATED_NAME" ]]; then
              echo "📋 Generated title: $GENERATED_NAME"
            fi
          else
            echo "❌ API call failed or returned insufficient content"
            echo "Response: $NOTES_RESPONSE"
            
            # Fallback to basic notes if API completely fails
            RECENT_COMMITS=$(git log --oneline "$PREVIOUS_TAG..HEAD" 2>/dev/null || git log --oneline -5)
            AI_NOTES="## What's Changed

This release includes the latest updates and improvements to CopyDVD.

**Recent Changes:**
$RECENT_COMMITS

**Full Changelog**: https://github.com/${{ github.repository }}/compare/${PREVIOUS_TAG}...v${{ steps.version.outputs.version }}"
            
            echo "⚠️ Using fallback release notes with commit list"
          fi
          
          # Now create the release with the generated notes
          RELEASE_TITLE="CopyDVD v${{ steps.version.outputs.version }}"
          if [[ -n "$GENERATED_NAME" ]]; then
            RELEASE_TITLE="$GENERATED_NAME"
          fi
          
          # Determine if this is a prerelease
          if [[ "${{ steps.version.outputs.version }}" == *"alpha"* ]] || [[ "${{ steps.version.outputs.version }}" == *"beta"* ]] || [[ "${{ steps.version.outputs.version }}" == *"rc"* ]]; then
            IS_PRERELEASE=true
          else
            IS_PRERELEASE=false
          fi
          
          RELEASE_DATA=$(jq -n \
            --arg tag_name "v${{ steps.version.outputs.version }}" \
            --arg name "$RELEASE_TITLE" \
            --arg body "$AI_NOTES" \
            --arg target_commitish "${{ github.sha }}" \
            --argjson draft true \
            --argjson prerelease "$IS_PRERELEASE" \
            '{
              tag_name: $tag_name,
              name: $name,
              body: $body,
              draft: $draft,
              prerelease: $prerelease,
              target_commitish: $target_commitish
            }')
          
          # Create the release with the AI-generated content
          RELEASE_RESPONSE=$(curl -L \
            -X POST \
            -H "Accept: application/vnd.github+json" \
            -H "Authorization: Bearer ${{ secrets.GITHUB_TOKEN }}" \
            -H "X-GitHub-Api-Version: 2022-11-28" \
            https://api.github.com/repos/${{ github.repository }}/releases \
            -d "$RELEASE_DATA")
          
          # Extract release ID
          RELEASE_ID=$(echo "$RELEASE_RESPONSE" | jq -r '.id // ""')
          
          echo "🎉 Draft release created with AI-generated content!"
          
          echo "release_id=$RELEASE_ID" >> $GITHUB_OUTPUT
          echo "ai_notes<<EOF" >> $GITHUB_OUTPUT
          echo "$AI_NOTES" >> $GITHUB_OUTPUT
          echo "EOF" >> $GITHUB_OUTPUT
          
          # Create enhanced release notes combining AI analysis with build info
          # First write AI notes safely
          echo "$AI_NOTES" > final_release_notes.md
          
          # Then append the rest of the release notes
          cat >> final_release_notes.md << 'EOF'
          
          ---
          
          ## 💾 Downloads
          
          Choose the appropriate version for your operating system:
          
          | Platform | Architecture | Download | Features |
          |----------|-------------|----------|----------|
          | **Windows** | x64 | \`copydvd-windows-${{ steps.version.outputs.version }}.exe\` | Full (GUI + CLI) |
          | **macOS** | Intel | \`copydvd-macos-intel-${{ steps.version.outputs.version }}\` | Full (GUI + CLI) |
          | **macOS** | Apple Silicon | \`copydvd-macos-arm-${{ steps.version.outputs.version }}\` | Full (GUI + CLI) |
          | **Linux** | x64 | \`copydvd-linux-${{ steps.version.outputs.version }}\` | Full (GUI + CLI) |
          
          ### 📦 Installers
          - \`copydvd-macos-intel-${{ steps.version.outputs.version }}.pkg\` - macOS PKG Installer (Intel) 
          - \`copydvd-macos-arm-${{ steps.version.outputs.version }}.pkg\` - macOS PKG Installer (Apple Silicon)
          - \`copydvd-windows-${{ steps.version.outputs.version }}.msi\` - Windows MSI Installer
          
          ## 🚀 Quick Start
          
          ### Windows
          **Option 1: MSI Installer (Recommended)**
          1. Download \`CopyDVD-x86_64-pc-windows-msvc.msi\`
          2. Double-click to install - creates Start Menu shortcuts
          
          **Option 2: Portable Executable**
          1. Download \`copydvd-x86_64-pc-windows-msvc.exe\`
          2. Run the executable directly
          
          ### macOS  
          1. Download the appropriate \`.pkg\` installer for your Mac (Intel or Apple Silicon)
          2. Double-click the PKG file to launch the installer
          3. Follow the installation wizard with welcome screen, license agreement, and completion
          4. The installer automatically places CopyDVD in your Applications folder
          5. **Important**: On first launch, right-click CopyDVD in Applications → Open → Click "Open" to bypass security warning
          6. Alternatively: System Preferences → Security & Privacy → Allow CopyDVD
          
          ### Linux
          1. Download \`copydvd-x86_64-unknown-linux-gnu\`
          2. Make executable: \`chmod +x copydvd-x86_64-unknown-linux-gnu\`
          3. Run: \`./copydvd-x86_64-unknown-linux-gnu\`
          
          ## 🖥️ Usage Modes
          
          - **GUI Mode** (default): Launch without arguments for the graphical interface
          - **CLI Mode**: Add \`--cli\` flag for command-line operation
          - **Help**: Use \`--help\` to see all available options
          
          ## ⚙️ System Requirements
          
          - **RAM**: 4GB minimum, 8GB recommended
          - **Storage**: Sufficient space for DVD content (typically 4-8GB per DVD)
          - **DVD Drive**: Physical drive or mounted ISO files
          - **HandBrake**: Automatically installed by the application
          
          ---
          
          EOF
          
          # Add build information with proper variable expansion
          echo "" >> final_release_notes.md
          echo "**Build Information**: $BUILD_TYPE • $(date -u '+%Y-%m-%d %H:%M UTC') • [\`${{ github.sha }}\`](https://github.com/${{ github.repository }}/commit/${{ github.sha }})" >> final_release_notes.md
          
          echo "Final enhanced release notes created"

      - name: Update release with AI notes and assets
        run: |
          # Update the release with final notes and make it public
          UPDATE_DATA=$(jq -n \
            --rawfile body final_release_notes.md \
            --argjson draft false \
            '{
              body: $body,
              draft: $draft
            }')
          
          curl -L \
            -X PATCH \
            -H "Accept: application/vnd.github+json" \
            -H "Authorization: Bearer ${{ secrets.GITHUB_TOKEN }}" \
            -H "X-GitHub-Api-Version: 2022-11-28" \
            https://api.github.com/repos/${{ github.repository }}/releases/${{ steps.ai_release_notes.outputs.release_id }} \
            -d "$UPDATE_DATA"
          
          echo "Release updated with AI-generated notes and published"

      - name: Upload release assets
        run: |
          # Upload all the built assets to the release
          for file in release/*; do
            if [[ -f "$file" ]]; then
              echo "Uploading $(basename "$file")..."
              curl -L \
                -X POST \
                -H "Accept: application/vnd.github+json" \
                -H "Authorization: Bearer ${{ secrets.GITHUB_TOKEN }}" \
                -H "X-GitHub-Api-Version: 2022-11-28" \
                -H "Content-Type: application/octet-stream" \
                "https://uploads.github.com/repos/${{ github.repository }}/releases/${{ steps.ai_release_notes.outputs.release_id }}/assets?name=$(basename "$file")" \
                --data-binary "@$file"
            fi
          done
          
          echo "All assets uploaded successfully"

